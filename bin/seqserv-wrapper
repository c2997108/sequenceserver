#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

export PATH="${APP_ROOT}/vendor/ruby-3.0.7-withssl/bin:${PATH}"
export GEM_HOME="${APP_ROOT}/vendor/ruby-3.0.7-withssl/lib/ruby/gems/3.0.0"
export GEM_PATH="${GEM_HOME}"
export BUNDLE_GEMFILE="${APP_ROOT}/Gemfile"
export BUNDLE_PATH="${APP_ROOT}/vendor/bundle"
export BUNDLE_WITHOUT="${BUNDLE_WITHOUT:-development:test}"

DEFAULT_DB_DIR="${APP_ROOT}/data/blastdb"
DB_DIR="${SEQSERVER_DB_DIR:-${DEFAULT_DB_DIR}}"

db_arg_present=0
for arg in "$@"; do
  case "$arg" in
    --database_dir|-d|--database_dir=*|-d=*)
      db_arg_present=1
      break
      ;;
  esac
done

if [[ ${db_arg_present} -eq 0 ]]; then
  mkdir -p "${DB_DIR}"
  set -- "$@" --database_dir "${DB_DIR}"
fi

cd "${APP_ROOT}"
exec bundle _2.5.17_ exec bin/sequenceserver "$@"
